<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.software.input_methods"
        android:required="false" />

    <!-- Real-time QR scan (camera2). Optional so the IME still installs on camera-less devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/png" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <data android:mimeType="image/png" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".DecryptShareActivity"
            android:exported="true"
            android:label="@string/decrypt_share_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".EncryptActivity"
            android:exported="false"
            android:label="@string/encrypt_share_name" />

        <!--
            The encrypt entry point for people who keep their own keyboard. Two filters,
            very different reliability:
              SEND         — resolved by the system chooser, so it shows up from every app.
              PROCESS_TEXT — only visible to host apps that declared <queries> for it, which
                             most do not since Android 11. A bonus, not the main path.
        -->
        <activity-alias
            android:name=".EncryptShareActivity"
            android:exported="true"
            android:label="@string/encrypt_share_name"
            android:targetActivity=".EncryptActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="文图易首次设置" />

        <activity
            android:name=".KeyManagementActivity"
            android:exported="false"
            android:label="身份与密钥" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="扫码 / 导入二维码" />

        <activity
            android:name=".CameraScanActivity"
            android:exported="false"
            android:label="实时扫码" />

        <activity
            android:name=".DecryptActivity"
            android:exported="false"
            android:label="解密接收" />

        <activity
            android:name=".ScreenDecryptActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="屏幕解密"
            android:theme="@style/ScreenDecryptTheme" />

        <service
            android:name=".ScreenDecryptService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".KeyboardTestActivity"
            android:exported="false" />

        <service
            android:name=".TextImageImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name=".ImageContentProvider"
            android:authorities="com.wentuyi.app.images"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
